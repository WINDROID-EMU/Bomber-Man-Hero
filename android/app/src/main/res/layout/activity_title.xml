<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D1117">

    <!-- Background Artwork -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bomber"
        android:contentDescription="Bomberman Hero Background" />

    <!-- Dark Overlay for Contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- Main Content Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical">

        <!-- Left Side: Title Header -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BOMBERMAN HERO"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECOMPILED • PORT ANDROID"
                android:textColor="#FF2ECC71"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:shadowColor="#80000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>

        <!-- Right Side: Menu Buttons Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/card_bg_dark"
            android:padding="24dp">

            <!-- Start Game Button -->
            <Button
                android:id="@+id/btnStartGame"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🎮 INICIAR JOGO"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_bg_primary"
                android:elevation="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Settings Button -->
            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="⚙️ CONFIGURAÇÕES"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_bg_secondary"
                android:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <!-- Exit Button -->
            <Button
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🚪 SAIR"
                android:textColor="#FFE74C3C"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/button_bg_secondary" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
